# Career-Ops Model Configuration
# Choose ONE provider below by setting MODEL_PROVIDER

# ============================================
# Option 1: Google Gemini (Default, Free tier)
# ============================================
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Option 2: GitHub Models (Free tier, No rate limit)
# ============================================
# MODEL_PROVIDER=github
# GITHUB_TOKEN=your_github_token_here
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# GITHUB_MODEL=meta/Llama-4-Scout-17B-16E-Instruct

# ============================================
# Option 3: Azure OpenAI (Paid, if you have credits)
# ============================================
# MODEL_PROVIDER=azure
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
